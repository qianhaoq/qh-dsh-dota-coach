{
  "name": "qh-dsh-dota-coach-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "typecheck": "pnpm generate && tsc -p packages/coach/tsconfig.host.json --noEmit && tsc -p packages/coach/tsconfig.client.json --noEmit",
    "generate": "tsx scripts/generate.ts",
    "build": "pnpm generate && tsx scripts/build.ts",
    "test": "pnpm build && tsx --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test",
    "pack:release": "tsx scripts/package.ts",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-remote-access": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-generator": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.3",
    "@memtensor/memos-local-plugin": "2.0.21",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.9.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tar": "7.5.22",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "zod": "4.4.3"
  }
}
